# ═══════════════════════════════════════════════════════════════════════════
# PulseMate Connect - Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values
# NEVER commit .env files with real secrets to Git

# ─────────────────────────────────────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/database
DIRECT_URL=postgresql://user:password@host:5432/database

# ─────────────────────────────────────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# JWT & Authentication Secrets
# ─────────────────────────────────────────────────────────────────────────────
# Generate secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
JWT_PHONE_VERIFY_EXPIRY=30m
JWT_EMAIL_VERIFY_EXPIRY=30m

# ─────────────────────────────────────────────────────────────────────────────
# Session Configuration (Production Cookie-Based Authentication)
# ─────────────────────────────────────────────────────────────────────────────
# Maximum session lifetime (regardless of activity)
SESSION_MAX_AGE_DAYS=30

# Idle timeout (session expires after this period of inactivity)  
SESSION_IDLE_TIMEOUT_DAYS=7

# Admin session settings (stricter security for privileged accounts)
ADMIN_SESSION_MAX_AGE_DAYS=7
ADMIN_SESSION_IDLE_TIMEOUT_DAYS=1

# Session cleanup (how often to remove expired sessions from database)
SESSION_CLEANUP_INTERVAL_HOURS=24

# ─────────────────────────────────────────────────────────────────────────────
# Cookie Configuration
# ─────────────────────────────────────────────────────────────────────────────
COOKIE_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Payment Gateway (Razorpay)
# ─────────────────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Firebase Authentication
# ─────────────────────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=

# ─────────────────────────────────────────────────────────────────────────────
# Cloud Storage (Cloudinary)
# ─────────────────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Email Service (Resend)
# ─────────────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# SMS Service (Message Central)
# ─────────────────────────────────────────────────────────────────────────────
SMS_PROVIDER=mock
MESSAGE_CENTRAL_BASE_URL=https://cpaas.messagecentral.com
MESSAGE_CENTRAL_CUSTOMER_ID=
MESSAGE_CENTRAL_EMAIL=
MESSAGE_CENTRAL_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# OTP Configuration
# ─────────────────────────────────────────────────────────────────────────────
OTP_PROVIDER=mock
ENABLE_TEST_OTP=true
TEST_OTP_CODE=123456
TEST_OTP_NUMBERS=9999999999,7777777777
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ─────────────────────────────────────────────────────────────────────────────
# Admin Bootstrap Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Used only for initial admin account creation
# Admin must reset password via password reset flow after bootstrap
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_LEVEL=ROOT

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
